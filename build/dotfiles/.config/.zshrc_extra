
# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Shared shell config
[ -f ~/.shellrc ] && source ~/.shellrc

# fzf configuration
if fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
else
    echo "Note: 'fzf --zsh' not available, skipping." >&2
fi
